# Copy this file to .env and set a long random password.
# It is used by both containers (WaveMP and PostgreSQL).
DB_PASSWORD=

# Optional: PIN of the built-in admin profile (4 to 8 digits). While it is set, the PIN cannot be
# changed in the app.
# ADMIN_PIN=

# Development only (docker-compose.dev.yml): host ports if 8080 or 5432 are already in use.
# WAVEMP_PORT=8080
# DB_PORT=5432
