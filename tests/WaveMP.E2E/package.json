{
  "name": "wavemp-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts screenshots/readme.screenshots.ts",
    "screenshots:catalogs": "playwright test --config playwright.screenshots.config.ts screenshots/catalog.screenshots.ts",
    "install-browsers": "playwright install --with-deps chromium",
    "theme:screenshots": "node screenshots/theme-run.ts",
    "theme:contrast": "node screenshots/theme-run.ts --contrast-only",
    "test:themes": "node scripts/theme-regression.ts",
    "test:themes:update": "node scripts/theme-regression.ts --update"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2"
  }
}
