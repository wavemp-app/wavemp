<Project>

  <PropertyGroup>
    <!--
      Major and minor version, changed by the maintainer only. The patch number is the run number
      of the CI workflow main.yml, which builds with -p:Version=<major>.<minor>.<run number>.
      Builds without that property (local builds, pull requests) report <major>.<minor>.0-dev.
    -->
    <VersionPrefix>1.0</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix).0-dev</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required so that IDE0005 (unnecessary usings) is reported during build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
